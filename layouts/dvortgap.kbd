(defcfg
    process-unmapped-keys yes
)

(defvar
  tap-time  150
  hold-time 150
)

(defsrc
`
      1 2 3 4 5  6 7 8 9 0 - =
   tab q w e r t  y u i o p [ ]
   caps a s d f g  h j k l ; '
    lsft z x c v b  n m , . / rsft
        lmet lalt spc ralt rmet
)

(deflayer dvortgap (tap-hold $tap-time $hold-time ` (layer-switch qwerty))
      _ _ _ _ _  _ _ _ _ _ [ ]
@tabnu / u o y j  k d l c w x = 
@navab  a i e n p  m h t s r -
       _ , ; ' .  q b f g v z  _
        lalt lmet _ rmet ralt
)

(deflayer nav
     _ _ _ _ _ _  _ _ _ _ _ _ _
_      _ _ _ _ _  prev @{ ↑ @} next _ _ 
_     ret _ _ _ _   C-u  ← ↓ →  esc _
    _  _ pp _ _   @~ C-d [ @v ]   _  _
            _ _ lalt lsft _
)

(deflayer numpad
     _ _ _ _ _ _  _ nlk  /   8 _ _ _
_      _ _ _ _ _   _ S-7 S-8 S-9 - _ _ 
_       _ _ _ _ _   6 S-4 S-5 S-6 @+ _
    _    _ _ _ _   _ _ S-1 S-2 S-3 ret  _
                  _ _ S-0 . _
)

(defalias `
    (tap-hold $tap-time $hold-time ` (layer-switch qwerty))
)

(deflayermap (qwerty)
  ` (tap-hold $tap-time $hold-time ` (layer-switch dvortgap))
  _ use-defsrc
)

(defalias
    navab (tap-hold $tap-time $hold-time A-bspc (layer-while-held nav))
    tabnu (tap-hold $tap-time $hold-time tab (layer-while-held numpad))
    v (macro S-; w ret)
    { S-[
    } S-]
    ~ S-`
    _ S--
    + S-=
)

(defoverrides
    (1) (lsft 1)
    (2) (lsft 2)
    (3) (lsft 3)
    (4) (lsft 4)
    (5) (lsft 5)
    (6) (lsft 6)
    (7) (lsft 7)
    (8) (lsft 8)
    (9) (lsft 9)
    (0) (lsft 0)

    (lsft 1) (1) (rsft 1) (1)
    (lsft 2) (2) (rsft 2) (2)
    (lsft 3) (3) (rsft 3) (3)
    (lsft 4) (4) (rsft 4) (4)
    (lsft 5) (5) (rsft 5) (5)
    (lsft 6) (6) (rsft 6) (6)
    (lsft 7) (7) (rsft 7) (7)
    (lsft 8) (8) (rsft 8) (8)
    (lsft 9) (9) (rsft 9) (9)
    (lsft 0) (0) (rsft 0) (0)
)

;; vim: set ft=lisp:
