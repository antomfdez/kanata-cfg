(defsrc
        1    2    3    4    5  bspc   6    7    8    9    0    -    =
        q    w    e    r    t         y    u    i    o    p    [    ]
  caps  a    s    d    f    g         h    j    k    l    ;    '
        z    x    c    v    b    <    n    m    ,    .    /
                  lmet          spc             rmet
)

(deflayer base
        _    _    _    _    _    _    _    _    _    _    _    [    ]
        z    m    r    l    f         j    y    o    u    '    -    =
  lctl  n    t    h    s    b         c    d    e    i    a    ,
        x    q    w    k    v    <    p    g    /    .    ;
                  _              _              @nav
)

;; Fingermap
;;  0 1 2 2 3  4 4 5 6 7
;;   0 1 2 3 3  4 4 5 6 7 7
;;    0 1 3 3 3  4 4 5 6 7

(defalias
  nav (layer-while-held navigation)
)

;; Navigation layer:

(defalias
  wl  A-left
  wr  A-right
  ll  M-left
  lr  M-right
  bck M-[
  fwd M-]
  run M-l
)

(deflayer navigation
    C-n  C-t  C-h  C-s  _     _   _    _    _    _    _    _  _
    XX   XX   @bck @fwd XX        XX   pgdn pgup rght @run _  _
  _ XX   XX   XX   tab  XX        @wl  down up   @wr  @lr   _
    XX   XX   XX   XX   XX    _   lft  @ll  home end  XX
              _               _             _
)

(defoverrides

  ;; Nokwts punct

  (lsft ') (lsft ,)
  (rsft ') (rsft ,)

  (lsft ,) (lsft ')
  (rsft ,) (rsft ')

  (lsft -) (lsft ;)
  (rsft -) (rsft ;)

  (lsft /) (lsft =)
  (rsft /) (rsft =)

  (lsft .) (lsft -)
  (rsft .) (rsft -)

  (lsft =) (lsft .)
  (rsft =) (rsft .)

  (lsft ;) (lsft /)
  (rsft ;) (rsft /)
)

(defcfg
  process-unmapped-keys yes
  windows-altgr cancel-lctl-press
)

;; vim: set ft=lisp:
