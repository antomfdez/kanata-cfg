(defsrc
        1    2    3    4    5  bspc   6    7    8    9    0    -    =
        q    w    e    r    t         y    u    i    o    p    [    ]
  caps  a    s    d    f    g         h    j    k    l    ;    '
        z    x    c    v    b    <    n    m    ,    .    /
                  lmet          spc             rmet
)

(deflayer base
        _    _    _    _    _    _    _    _    _    _    _    [    ]
        z    m    r    l    f         j    y    o    u    '    -    =
  lmet  n    t    h    s    b         c    d    e    i    a    ,
        x    q    w    k    v    <    p    g    /    .    ;
                  lsft           _              @nav
)

;; Fingermap
;;  0 1 2 2 3  4 4 5 6 7
;;   0 1 2 3 3  4 4 5 6 7 7
;;    0 1 3 3 3  4 4 5 6 7

(defalias
  nav (layer-while-held navigation)
)

;; Navigation layer:

(defalias
  wl  A-left
  wr  A-right
  ll  M-left
  lr  M-right
  bck M-[
  fwd M-]
  run M-l
)

(deflayer navigation
    C-n  C-t  C-h  C-s  _     _   _    _    _    _    _    _  _
    XX   XX   @bck @fwd XX        XX   pgdn pgup rght @run _  _
  _ XX   XX   XX   tab  XX        @wl  down up   @wr  @lr   _
    XX   XX   XX   XX   XX    _   lft  @ll  home end  XX
              _               _             _
)

(defoverrides

  ;; Nokwts punct

  (lsft ') (lsft ,)
  (rsft ') (rsft ,)

  (lsft ,) (lsft ')
  (rsft ,) (rsft ')

  (lsft -) (lsft ;)
  (rsft -) (rsft ;)

  (lsft /) (lsft =)
  (rsft /) (rsft =)

  (lsft .) (lsft -)
  (rsft .) (rsft -)

  (lsft =) (lsft .)
  (rsft =) (rsft .)

  (lsft ;) (lsft /)
  (rsft ;) (rsft /)

  ;; Swap 1234567890 with !@#$%^&*()

  (1) (lsft 1)
  (2) (lsft 2)
  (3) (lsft 3)
  (4) (lsft 4)
  (5) (lsft 5)
  (6) (lsft 6)
  (7) (lsft 7)
  (8) (lsft 8)
  (9) (lsft 9)
  (0) (lsft 0)

  (lsft 1) (1)
  (lsft 2) (2)
  (lsft 3) (3)
  (lsft 4) (4)
  (lsft 5) (5)
  (lsft 6) (6)
  (lsft 7) (7)
  (lsft 8) (8)
  (lsft 9) (9)
  (lsft 0) (0)
)

(defcfg
  process-unmapped-keys yes
  windows-altgr cancel-lctl-press
)

;; vim: set ft=lisp:
